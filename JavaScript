// ---------- CART ----------
function resetCart() {
  if (!currentUser) return;
  const saved = JSON.parse(localStorage.getItem("nexaCart_" + currentUser.email)) || [];
  // not used for demo
  renderCart();
}

function addToCart(bookId) {
  const item = cart.find(b => b.id === bookId);
  if (item) {
    item.quantity += 1;
  } else {
    cart.push({ ...books.find(b => b.id === bookId), quantity: 1 });
  }
  renderCart();
}

function removeFromCart(bookId) {
  const index = cart.findIndex(item => item.id === bookId);
  if (index >= 0) {
    cart.splice(index, 1);
  }
  renderCart();
}

function updateQuantity(bookId, delta) {
  const item = cart.find(b => b.id === bookId);
  if (!item) return;
  item.quantity += delta;
  if (item.quantity <= 0) {
    removeFromCart(bookId);
    return;
  }
  renderCart();
}

function getCartTotal() {
  const subtotal = cart.reduce((sum, item) => sum + item.price * item.quantity, 0);
  const fees = cart.length ? 2.5 : 0;
  const total = subtotal + fees;
  return { subtotal, fees, total };
}

function renderCart() {
  cartItems.innerHTML = "";

  if (cart.length === 0) {
    cartItems.innerHTML = "<p>Votre panier est vide.</p>";
    subtotalEl.textContent = "0,00 €";
    feesEl.textContent = "0,00 €";
    totalEl.textContent = "0,00 €";
    cartCount.textContent = "0";
    return;
  }

  cart.forEach(item => {
    const row = document.createElement("div");
    row.className = "cart-item";

    row.innerHTML = `
      <div>
        <h5>${item.title}</h5>
        <p>${item.price.toFixed(2)} €</p>
      </div>
      <div class="item-controls">
        <button class="qty-btn" data-action="minus" data-id="${item.id}">-</button>
        <span>${item.quantity}</span>
        <button class="qty-btn" data-action="plus" data-id="${item.id}">+</button>
      </div>
    `;

    cartItems.appendChild(row);
  });

  document.querySelectorAll(".qty-btn").forEach(btn => {
    btn.addEventListener("click", () => {
      const id = Number(btn.dataset.id);
      const action = btn.dataset.action;
      if (action === "plus") updateQuantity(id, 1);
      if (action === "minus") updateQuantity(id, -1);
    });
  });

  const totals = getCartTotal();
  subtotalEl.textContent = totals.subtotal.toFixed(2) + " €";
  feesEl.textContent = totals.fees.toFixed(2) + " €";
  totalEl.textContent = totals.total.toFixed(2) + " €";
  cartCount.textContent = cart.reduce((sum, item) => sum + item.quantity, 0).toString();
}

