// ---------- BOOKS ----------
function getFilteredBooks() {
  return books.filter(book => {
    const matchesCategory = selectedFilter === "all" || book.category === selectedFilter;
    const term = searchKeyword.toLowerCase();
    const matchesSearch = !term || book.title.toLowerCase().includes(term) || book.description.toLowerCase().includes(term);
    return matchesCategory && matchesSearch;
  });
}

function renderBooks() {
  booksGrid.innerHTML = "";

  const filteredBooks = getFilteredBooks();

  if (filteredBooks.length === 0) {
    booksGrid.innerHTML = "<p>Aucun livre trouvé.</p>";
    return;
  }

  filteredBooks.forEach(book => {
    const card = document.createElement("article");
    card.className = "book-card";

    card.innerHTML = `
      <div class="book-cover">${book.title.split(" ")[0].slice(0, 2).toUpperCase()}</div>
      <div class="book-info">
        <div class="book-meta">
          <span class="book-tag">${book.tag}</span>
          <span class="price">${book.price.toFixed(2)} €</span>
        </div>
        <h4>${book.title}</h4>
        <p>${book.description}</p>
        <div class="book-actions">
          <button class="view-btn" data-id="${book.id}">Voir le livre</button>
          <button class="buy-btn" data-id="${book.id}">Acheter</button>
        </div>
      </div>
    `;

    booksGrid.appendChild(card);
  });

  document.querySelectorAll(".view-btn").forEach(btn => {
    btn.addEventListener("click", () => openBookDetail(Number(btn.dataset.id)));
  });

  document.querySelectorAll(".buy-btn").forEach(btn => {
    btn.addEventListener("click", () => {
      addToCart(Number(btn.dataset.id));
      cartModal.classList.remove("hidden");
    });
  });
}

searchInput.addEventListener("input", (e) => {
  searchKeyword = e.target.value;
  renderBooks();
});

filterButtons.forEach(button => {
  button.addEventListener("click", () => {
    selectedFilter = button.dataset.filter;
    filterButtons.forEach(b => b.classList.toggle("active", b === button));
    renderBooks();
  });
});

