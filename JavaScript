// ---------- PROFILE ----------
function renderProfile() {
  const user = JSON.parse(localStorage.getItem("nexaCurrentUser"));
  if (!user) return;

  profileFirstName.textContent = user.firstName;
  profileLastName.textContent = user.lastName;
  profileEmail.textContent = user.email;
  profileNationality.textContent = user.nationality;
  profilePhone.textContent = user.phone;

  const purchased = JSON.parse(localStorage.getItem("nexaPurchased_" + user.email)) || [];
  purchasedList.innerHTML = "";
  if (!purchased.length) {
    purchasedList.innerHTML = "<li>Aucun achat pour le moment.</li>";
    return;
  }

  purchased.forEach(title => {
    const li = document.createElement("li");
    li.textContent = title;
    purchasedList.appendChild(li);
  });
}

