  if (!paymentPhone) {
    alert("Veuillez saisir votre numéro pour le paiement.");
    return;
  }

  if (cart.length === 0) {
    alert("Votre panier est vide.");
    return;
  }

  const purchased = cart.map(item => item.title);
  const purchasedKey = "nexaPurchased_" + currentUser.email;
  const oldPurchases = JSON.parse(localStorage.getItem(purchasedKey)) || [];
  const merged = [...oldPurchases, ...purchased];
  localStorage.setItem(purchasedKey, JSON.stringify(merged));

  alert(`Paiement via ${selectedMethod.toUpperCase()} confirmé. Votre commande a bien été enregistrée.`);
  paymentModal.classList.add("hidden");
  cart.splice(0, cart.length);
  renderCart();
  renderProfile();
});

