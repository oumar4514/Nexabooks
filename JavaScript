  const book = books.find(b => b.id === bookId);
  const detailContent = document.getElementById("bookDetailContent");
  document.getElementById("bookDetailModal").classList.remove("hidden");

  detailContent.innerHTML = `
    <div class="detail-layout">
      <div class="detail-cover">${book.title.split(" ")[0].slice(0, 2).toUpperCase()}</div>
      <div class="detail-info">
        <span class="tag">${book.tag}</span>
        <h3>${book.title}</h3>
        <p>${book.description}</p>
        <ul>
          <li><strong>Auteur :</strong> ${book.author}</li>
          <li><strong>Pages :</strong> ${book.pages}</li>
          <li><strong>Prix :</strong> ${book.price.toFixed(2)} €</li>
        </ul>
        <div class="detail-actions">
          <button class="primary-btn" data-buy="${book.id}">Acheter maintenant</button>
        </div>
      </div>
    </div>
    <div class="detail-section">
      <h4>Ce que vous allez apprendre</h4>
      <ul class="check-list">
        ${book.learning.map(item => `<li>${item}</li>`).join("")}
      </ul>
    </div>
    <div class="detail-section">
      <h4>Chapitres</h4>
      <ul class="chapter-list">
        ${book.chapters.map(ch => `<li>${ch}</li>`).join("")}
      </ul>
    </div>
  `;

  document.querySelector("[data-buy]").addEventListener("click", () => {
    addToCart(book.id);
    document.getElementById("bookDetailModal").classList.add("hidden");
    cartModal.classList.remove("hidden");
  });
}

