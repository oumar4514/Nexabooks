// ---------- AUTH ----------
function hashPassword(password) {
  return btoa(password + "_nexa_secure_");
}

function saveUser(user) {
  const users = JSON.parse(localStorage.getItem("nexaUsers")) || [];
  users.push(user);
  localStorage.setItem("nexaUsers", JSON.stringify(users));
}

function getUsers() {
  return JSON.parse(localStorage.getItem("nexaUsers")) || [];
}

function isUserAuthenticated() {
  return localStorage.getItem("nexaCurrentUser") !== null;
}

function loginUser(email, password) {
  const users = getUsers();
  const user = users.find(u => u.email.toLowerCase() === email.toLowerCase() && u.password === hashPassword(password));
  if (user) {
    localStorage.setItem("nexaCurrentUser", JSON.stringify(user));
    currentUser = user;
    return true;
  }
  return false;
}

function registerUser(data) {
  const users = getUsers();
  const exists = users.some(u => u.email.toLowerCase() === data.email.toLowerCase());
  if (exists) {
    alert("Un compte existe déjà avec cet e-mail.");
    return false;
  }

  const newUser = {
    ...data,
    password: hashPassword(data.password)
  };

  saveUser(newUser);
  localStorage.setItem("nexaCurrentUser", JSON.stringify(newUser));
  currentUser = newUser;
  return true;
}

function logout() {
  localStorage.removeItem("nexaCurrentUser");
  currentUser = null;
  app.classList.add("hidden");
  authScreen.classList.remove("hidden");
  document.getElementById("loginForm").classList.add("hidden");
  document.getElementById("registerForm").classList.remove("hidden");
}

