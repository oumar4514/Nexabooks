:root {
  --bg: #0d0d0f;
  --bg-soft: #141418;
  --card: #17171d;
  --main: #d61c28;
  --main-dark: #9d111a;
  --white: #ffffff;
  --muted: #dfe3ea;
  --text: #1a1a1a;
  --line: rgba(255, 255, 255, 0.08);
  --success: #1ea76d;
  --shadow: 0 20px 40px rgba(0, 0, 0, 0.18);
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
}

body {
  font-family: "Inter", sans-serif;
  background: #f5f5f7;
  color: var(--text);
}

a {
  text-decoration: none;
  color: inherit;
}

button, input, select {
  font: inherit;
}

.hidden {
  display: none !important;
}

.container {
  max-width: 1180px;
  margin: 0 auto;
  padding: 0 24px;
}

/* AUTH SCREEN */
.auth-screen {
  min-height: 100vh;
  background:
    linear-gradient(135deg, rgba(214, 28, 40, 0.92), rgba(15, 15, 17, 0.96)),
    url("https://images.unsplash.com/photo-1516979187454-437ec3e3de9b?auto=format&fit=crop&w=1200&q=80") center/cover no-repeat;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40px 20px;
}

.auth-shell {
  width: min(1200px, 100%);
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: 28px;
  overflow: hidden;
  backdrop-filter: blur(12px);
  box-shadow: var(--shadow);
}

.auth-panel {
  padding: 42px 36px;
}

.form-panel {
  background: rgba(10, 10, 12, 0.8);
  color: white;
}

.brand-block h1 {
  font-size: clamp(2.2rem, 3vw, 3.4rem);
  margin-top: 20px;
  margin-bottom: 10px;
}

.badge {
  display: inline-block;
  background: rgba(255,255,255,0.08);
  border: 1px solid rgba(255,255,255,0.12);
  border-radius: 999px;
  padding: 8px 16px;
  font-size: 0.78rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.brand-block p {
  color: #d9dce3;
  font-size: 1.05rem;
  margin-bottom: 26px;
}

.auth-form {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.auth-form h2 {
  font-size: 1.7rem;
  margin-bottom: 4px;
}

.row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;
}

.field {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.field label {
  font-size: 0.9rem;
  color: #eef1f7;
}

.field input,
.field select {
  width: 100%;
  padding: 14px 14px;
  border-radius: 12px;
  border: 1px solid rgba(255,255,255,0.12);
  background: rgba(255,255,255,0.03);
  color: white;
  outline: none;
}

.field input::placeholder {
  color: #cfd5df;
}

.checkbox {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  color: #eceef3;
  font-size: 0.9rem;
  line-height: 1.5;
}

.checkbox input {
  margin-top: 2px;
  width: 18px;
  height: 18px;
  accent-color: var(--main);
}

.primary-btn, .secondary-btn, .cart-btn, .profile-btn, .logout-btn {
  border: none;
  cursor: pointer;
  transition: 0.25s ease;
}

.primary-btn {
  background: linear-gradient(135deg, var(--main), #ee3b45);
  color: white;
  font-weight: 700;
  padding: 14px 22px;
  border-radius: 12px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.primary-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 16px 30px rgba(214, 28, 40, 0.3);
}

.secondary-btn {
  background: #ececf0;
  color: var(--text);
  padding: 12px 18px;
  border-radius: 12px;
  font-weight: 600;
}

.full {
  width: 100%;
}

.switch-text {
  color: #dfe5ef;
  text-align: center;
  margin-top: 10px;
}

.switch-text a {
  color: #ffb4b9;
  font-weight: 600;
}

.visual-panel {
  position: relative;
  background: rgba(255,255,255,0.04);
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 500px;
}

.floating-card {
  position: absolute;
  background: rgba(255,255,255,0.08);
  border: 1px solid rgba(255,255,255,0.12);
  border-radius: 18px;
  padding: 18px 20px;
  color: white;
  backdrop-filter: blur(10px);
  display: flex;
  align-items: center;
  gap: 14px;
  width: 260px;
  box-shadow: var(--shadow);
}

.floating-card span {
  font-size: 1.8rem;
}

.floating-card strong {
  display: block;
  margin-bottom: 2px;
}

.card-one {
  top: 80px;
  left: 80px;
}

.card-two {
  top: 220px;
  right: 70px;
}

.card-three {
  bottom: 70px;
  left: 120px;
}

/* APP */
.app {
  background: #f5f5f7;
}

.site-header {
  position: sticky;
  top: 0;
  background: rgba(18, 18, 20, 0.9);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid rgba(255,255,255,0.06);
  z-index: 50;
}

.nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 80px;
}

.logo {
  font-weight: 900;
  font-size: 1.8rem;
  color: white;
}

.navbar {
  display: flex;
  gap: 28px;
  color: #e8ebf0;
  font-weight: 500;
}

.nav-actions {
  display: flex;
  align-items: center;
  gap: 12px;
}

.cart-btn, .profile-btn, .logout-btn {
  background: rgba(255,255,255,0.08);
  color: white;
  padding: 11px 16px;
  border-radius: 999px;
}

.cart-btn {
  background: var(--main);
  font-weight: 700;
}

.hero {
  background: radial-gradient(circle at top left, rgba(214, 28, 40, 0.18), transparent 35%), #0e0e11;
  padding: 90px 0 70px;
}

.hero-wrap {
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  align-items: center;
  gap: 50px;
}

.hero-text h2 {
  color: white;
  font-size: clamp(2.4rem, 5vw, 4.5rem);
  line-height: 1.08;
  margin-bottom: 20px;
}

.tag {
  display: inline-block;
  background: rgba(214, 28, 40, 0.15);
  color: #ffc8cd;
  border: 1px solid rgba(214, 28, 40, 0.3);
  padding: 8px 14px;
  border-radius: 999px;
  margin-bottom: 18px;
  font-size: 0.8rem;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  font-weight: 700;
}

.hero-text p {
  color: #dfe4ee;
  font-size: 1.1rem;
  line-height: 1.8;
  max-width: 620px;
  margin-bottom: 28px;
}

.hero-actions {
  display: flex;
  gap: 16px;
}

.hero-visual {
  display: flex;
  justify-content: center;
  align-items: center;
}

.book-stack {
  position: relative;
  width: 350px;
  height: 420px;
}

.book {
  position: absolute;
  width: 200px;
  height: 280px;
  border-radius: 22px;
  background: linear-gradient(135deg, #991b28, #e8404f);
  box-shadow: var(--shadow);
  transform: rotate(-12deg);
  border: 2px solid rgba(255,255,255,0.14);
}

.book.one {
  left: 36px;
  top: 40px;
}

.book.two {
  left: 90px;
  top: 72px;
  background: linear-gradient(135deg, #d32230, #f57e84);
  transform: rotate(8deg);
}

.book.three {
  left: 50px;
  top: 110px;
  background: linear-gradient(135deg, #1f1f21, #4d4d54);
  transform: rotate(-3deg);
}

.values, .catalogue, .featured {
  padding: 90px 0;
}

.section-title {
  text-align: center;
  margin-bottom: 42px;
}

.section-title span {
  color: var(--main);
  font-weight: 700;
}

.section-title h3 {
  margin-top: 12px;
  font-size: clamp(2rem, 3vw, 2.8rem);
  color: #1b1d22;
}

.value-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 24px;
}

.value-card {
  background: white;
  border-radius: 24px;
  padding: 30px 26px;
  text-align: center;
  box-shadow: 0 14px 30px rgba(15, 15, 17, 0.06);
  border: 1px solid rgba(15,15,17,0.04);
}

.icon {
  font-size: 2.3rem;
  margin-bottom: 18px;
}

.value-card h4 {
  margin-bottom: 10px;
  font-size: 1.4rem;
}

.value-card p {
  color: #5a6475;
  line-height: 1.7;
}

.catalogue {
  background: #f0f0f3;
}

.catalogue-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
  margin-bottom: 30px;
}

.catalogue-top h3 {
  font-size: clamp(1.8rem, 2.8vw, 2.5rem);
  color: #1a1d21;
}

.search-box input {
  width: min(360px, 100%);
  padding: 14px 16px;
  border-radius: 999px;
  border: 1px solid #dfe3eb;
  background: white;
  outline: none;
}

.filter-bar {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-bottom: 30px;
}

.filter-btn {
  background: white;
  border: 1px solid #e4e7ec;
  color: var(--text);
  padding: 10px 16px;
  border-radius: 999px;
  cursor: pointer;
  font-weight: 600;
}

.filter-btn.active {
  background: var(--main);
  color: white;
  border-color: var(--main);
}

.books-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 26px;
}

.book-card {
  background: white;
  border-radius: 22px;
  overflow: hidden;
  box-shadow: 0 18px 35px rgba(15, 15, 17, 0.06);
  transition: 0.25s ease;
}

.book-card:hover {
  transform: translateY(-5px);
}

.book-cover {
  height: 260px;
  background: linear-gradient(135deg, #ac1d2b, #f5a4a9);
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 2.4rem;
  font-weight: 800;
}

.book-info {
  padding: 18px 18px 20px;
}

.book-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
}

.book-tag {
  display: inline-block;
  font-size: 0.7rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  padding: 8px 10px;
  border-radius: 999px;
  background: #fce8eb;
  color: var(--main-dark);
  font-weight: 700;
}

.price {
  font-weight: 800;
  color: #111;
}

.book-info h4 {
  font-size: 1.25rem;
  margin-bottom: 8px;
}

.book-info p {
  color: #5f6774;
  line-height: 1.7;
  margin-bottom: 16px;
}

.book-actions {
  display: flex;
  gap: 10px;
}

.view-btn {
  flex: 1;
  background: #f2f4f8;
  color: var(--text);
  border-radius: 12px;
  padding: 11px 14px;
  font-weight: 700;
  border: none;
  cursor: pointer;
}

.buy-btn {
  flex: 1;
  background: var(--main);
  color: white;
  border-radius: 12px;
  padding: 11px 14px;
  font-weight: 700;
  border: none;
  cursor: pointer;
}

.featured-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 22px;
}

.feature-box {
  background: white;
  border-radius: 22px;
  padding: 28px 22px;
  box-shadow: 0 18px 35px rgba(17, 17, 21, 0.05);
}

.feature-box h4 {
  margin-bottom: 10px;
  font-size: 1.35rem;
}

.feature-box p {
  line-height: 1.7;
  color: #5b6473;
}

.site-footer {
  background: #0d0d10;
  color: white;
  padding: 60px 0 20px;
}

.footer-grid {
  display: grid;
  grid-template-columns: 1.3fr 1fr 1fr;
  gap: 30px;
}

.site-footer h4 {
  margin-bottom: 16px;
  font-size: 1.15rem;
}

.site-footer p, .site-footer li, .site-footer a {
  color: #dfe5ef;
}

.site-footer ul {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.footer-bottom {
  margin-top: 30px;
  padding-top: 18px;
  border-top: 1px solid rgba(255,255,255,0.08);
}

/* MODALS */
.modal {
  position: fixed;
  inset: 0;
  background: rgba(11, 11, 13, 0.72);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 100;
  padding: 16px;
}

.modal-content {
  width: min(700px, 100%);
  background: white;
  border-radius: 24px;
  padding: 24px;
  box-shadow: var(--shadow);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20px;
}

.close-btn {
  background: #f2f4f7;
  border: none;
  width: 36px;
  height: 36px;
  border-radius: 50%;
  font-size: 1.8rem;
  cursor: pointer;
}

.cart-items {
  display: flex;
  flex-direction: column;
  gap: 14px;
  max-height: 300px;
  overflow: auto;
  padding-right: 4px;
}

.cart-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
  padding: 14px 10px;
  border: 1px solid #edf0f5;
  border-radius: 16px;
}

.cart-item h5 {
  margin-bottom: 4px;
}

.item-controls {
  display: flex;
  align-items: center;
  gap: 8px;
}

.qty-btn {
  width: 28px;
  height: 28px;
  border: none;
  border-radius: 50%;
  background: #f2f4f7;
  cursor: pointer;
  font-weight: 700;
}

.summary {
  margin-top: 20px;
  border-top: 1px solid #edf0f5;
  padding-top: 18px;
}

.summary p {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8px;
  color: #3a3f4d;
}

.summary p:last-child {
  font-size: 1.2rem;
}

.modal-actions {
  display: flex;
  gap: 12px;
  margin-top: 20px;
}

.payment-content {
  width: min(560px, 100%);
}

.payment-methods {
  display: grid;
  gap: 12px;
}

.payment-option {
  display: flex;
  align-items: center;
  gap: 12px;
  background: #f5f7fa;
  padding: 14px 16px;
  border-radius: 14px;
}

.payment-option input {
  width: 18px;
  height: 18px;
}

.payment-field {
  margin-top: 18px;
}

.payment-field input {
  width: 100%;
  padding: 14px;
  border-radius: 12px;
  border: 1px solid #e2e7ee;
  background: white;
  margin-top: 8px;
}

.profile-content {
  display: grid;
  gap: 20px;
}

.profile-info {
  background: #fafbfc;
  padding: 18px;
  border-radius: 18px;
}

.profile-info p {
  margin-bottom: 10px;
}

.profile-books h4 {
  margin-bottom: 12px;
}

#purchasedList {
  list-style: none;
  display: grid;
  gap: 10px;
}

#purchasedList li {
  background: #f5f7fa;
  padding: 10px 12px;
  border-radius: 12px;
}

/* RESPONSIVE */
@media (max-width: 900px) {
  .auth-shell {
    grid-template-columns: 1fr;
  }

  .visual-panel {
    min-height: 280px;
  }

  .hero-wrap, .value-grid, .featured-grid, .footer-grid {
    grid-template-columns: 1fr;
  }

  .navbar {
    display: none;
  }
}

@media (max-width: 600px) {
  .row {
    grid-template-columns: 1fr;
  }

  .nav {
    flex-wrap: wrap;
    gap: 12px;
    padding: 12px 0;
  }

  .nav-actions {
    width: 100%;
    justify-content: space-between;
  }

  .catalogue-top {
    flex-direction: column;
    align-items: flex-start;
  }

  .search-box input {
    width: 100%;
  }
}