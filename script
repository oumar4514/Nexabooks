function updateCartCount() {
  const cartCount = document.getElementById("cartCount");
  if (!cartCount) return;

  const user = getCurrentUser();
  if (!user) return;

  const cart = getCart(user.email);
  const totalQty = cart.reduce((sum, item) => sum + item.quantity, 0);
  cartCount.textContent = totalQty;
}

function addToCart(bookId) {
  const user = getCurrentUser();
  if (!user) return;

  const cart = getCart(user.email);
  const existing = cart.find((item) => item.id === bookId);

  if (existing) {
    existing.quantity += 1;
  } else {
    const book = books.find((b) => b.id === bookId);
    cart.push({ ...book, quantity: 1 });
  }

  setCart(user.email, cart);
  updateCartCount();
}

function removeFromCart(bookId) {
  const user = getCurrentUser();
  if (!user) return;

  const cart = getCart(user.email).filter((item) => item.id !== bookId);
  setCart(user.email, cart);
  renderCart();
}

function updateCartItemQuantity(bookId, delta) {
  const user = getCurrentUser();
  if (!user) return;

  const cart = getCart(user.email);
  const item = cart.find((entry) => entry.id === bookId);

  if (!item) return;

  item.quantity += delta;

  if (item.quantity <= 0) {
    const filtered = cart.filter((entry) => entry.id !== bookId);
    setCart(user.email, filtered);
  } else {
    setCart(user.email, cart);
  }

  renderCart();
}

function getCartTotal() {
  const user = getCurrentUser();
  if (!user) return { subtotal: 0, fees: 0, total: 0 };

  const cart = getCart(user.email);
  const subtotal = cart.reduce((sum, item) => sum + item.price * item.quantity, 0);
  const fees = cart.length ? 1500 : 0;
  const total = subtotal + fees;

  return { subtotal, fees, total };
}

function renderCart() {
  const cartItemsContainer = document.getElementById("cartItems");
  if (!cartItemsContainer) return;

  const user = getCurrentUser();
  if (!user) return;

  const cart = getCart(user.email);

  if (!cart.length) {
    cartItemsContainer.innerHTML = "<p>Votre panier est vide.</p>";
    document.getElementById("subtotal").textContent = "0 FCFA";
    document.getElementById("fees").textContent = "0 FCFA";
    document.getElementById("total").textContent = "0 FCFA";
    return;
  }

  cartItemsContainer.innerHTML = "";

  cart.forEach((item) => {
    const row = document.createElement("div");
    row.className = "cart-item";

    row.innerHTML = `
      <div>
        <h3>${item.title}</h3>
        <div class="price">${formatFCFA(item.price)}</div>
      </div>
      <div class="item-controls">
        <button class="qty-btn" data-action="minus" data-id="${item.id}">-</button>
        <span>${item.quantity}</span>
        <button class="qty-btn" data-action="plus" data-id="${item.id}">+</button>
      </div>
    `;

    cartItemsContainer.appendChild(row);
  });

  document.querySelectorAll(".qty-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      const id = Number(btn.dataset.id);
      const action = btn.dataset.action;
      if (action === "plus") updateCartItemQuantity(id, 1);
      if (action === "minus") updateCartItemQuantity(id, -1);
    });
  });

  const totals = getCartTotal();

  document.getElementById("subtotal").textContent = formatFCFA(totals.subtotal);
  document.getElementById("fees").textContent = formatFCFA(totals.fees);
  document.getElementById("total").textContent = formatFCFA(totals.total);
}

if (document.getElementById("payBtn")) {
  document.getElementById("payBtn").addEventListener("click", () => {
    const user = getCurrentUser();
    if (!user) return;

    const cart = getCart(user.email);

    if (!cart.length) {
      alert("Votre panier est vide.");
      return;
    }

    const paymentModal = document.getElementById("paymentModal");
    paymentModal.classList.remove("hidden");
  });
}

if (document.getElementById("closePayment")) {
  document.getElementById("closePayment").addEventListener("click", () => {
    document.getElementById("paymentModal").classList.add("hidden");
  });
}

if (document.getElementById("confirmPayment")) {
  document.getElementById("confirmPayment").addEventListener("click", () => {
    const user = getCurrentUser();
    if (!user) return;

    const cart = getCart(user.email);
    if (!cart.length) {
      alert("Votre panier est vide.");
      return;
    }

    const paymentPhone = document.getElementById("paymentPhone").value.trim();
    const selectedMethod = document.querySelector('input[name="paymentMethod"]:checked')?.value;

    if (!paymentPhone) {
      alert("Veuillez saisir votre numéro pour le paiement.");
      return;
    }

    const purchased = getPurchased(user.email);
    const titles = cart.map((item) => item.title);

    setPurchased(user.email, [...purchased, ...titles]);

    setCart(user.email, []);
    document.getElementById("paymentModal").classList.add("hidden");
    alert(`Paiement via ${selectedMethod} confirmé. Votre commande a bien été enregistrée.`);
    window.location.href = "profile.html";
  });
}

function renderBooksPage() {
  const booksGrid = document.getElementById("booksGrid");
  if (!booksGrid) return;

  let filter = "all";
  let search = "";

  const update = () => {
    const filtered = books.filter((book) => {
      const matchCategory = filter === "all" || book.category === filter;
      const matchText =
        !search ||
        book.title.toLowerCase().includes(search.toLowerCase()) ||
        book.description.toLowerCase().includes(search.toLowerCase());

      return matchCategory && matchText;
    });

    booksGrid.innerHTML = "";

    if (!filtered.length) {
      booksGrid.innerHTML = "<p>Aucun livre trouvé.</p>";
      return;
    }

    filtered.forEach((book) => {
      const card = document.createElement("article");
      card.className = "book-card";

      card.innerHTML = `
        <div class="book-cover">${book.title.slice(0, 2).toUpperCase()}</div>
        <div class="book-body">
          <div class="book-meta">
            <span class="book-tag">${book.tag}</span>
            <span class="price">${formatFCFA(book.price)}</span>
          </div>
          <h3>${book.title}</h3>
          <p>${book.description}</p>
          <div class="book-actions">
            <button class="view-btn" data-id="${book.id}">Voir le livre</button>
            <button class="buy-btn" data-id="${book.id}">Acheter</button>
          </div>
        </div>
      `;

      booksGrid.appendChild(card);
    });

    document.querySelectorAll(".view-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        const id = Number(btn.dataset.id);
        window.location.href = `product.html?id=${id}`;
      });
    });

    document.querySelectorAll(".buy-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        addToCart(Number(btn.dataset.id));
        window.location.href = "checkout.html";
      });
    });
  };

  const searchInput = document.getElementById("searchInput");
  if (searchInput) {
    searchInput.addEventListener("input", (e) => {
      search = e.target.value.trim();
      update();
    });
  }

  document.querySelectorAll(".filter-btn").forEach((button) => {
    button.addEventListener("click", () => {
      filter = button.dataset.filter;
      document.querySelectorAll(".filter-btn").forEach((btn) => btn.classList.remove("active"));
      button.classList.add("active");
      update();
    });
  });

  update();
  updateCartCount();
}

