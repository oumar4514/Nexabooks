function renderProfilePage() {
  const profileInfo = document.getElementById("profileInfo");
  const purchasedList = document.getElementById("purchasedList");

  if (!profileInfo || !purchasedList) return;

  const user = getCurrentUser();
  if (!user) return;

  profileInfo.innerHTML = `
    <p><strong>Prénom :</strong> ${user.firstName}</p>
    <p><strong>Nom :</strong> ${user.lastName}</p>
    <p><strong>E-mail :</strong> ${user.email}</p>
    <p><strong>Nationalité :</strong> ${user.nationality}</p>
    <p><strong>Téléphone :</strong> ${user.phone}</p>
  `;

  const purchased = getPurchased(user.email);

  if (!purchased.length) {
    purchasedList.innerHTML = "<li>Aucun achat pour le moment.</li>";
    return;
  }

  purchasedList.innerHTML = purchased.map((title) => `<li>${title}</li>`).join("");
  updateCartCount();
}

