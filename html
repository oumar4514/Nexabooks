<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>NexaBooks | Accès</title>
    <meta
      name="description"
      content="NexaBooks, la plateforme premium de vente d'e-books."
    />
    <link rel="stylesheet" href="style.css" />
  </head>
  <body class="auth-body">
    <div class="auth-shell">
      <div class="auth-panel form-panel">
        <div class="brand-block">
          <span class="badge">NexaBooks</span>
          <h1>Lis. Apprends. Évolue.</h1>
          <p>Des livres pour développer ton esprit, tes compétences et ton avenir.</p>
        </div>

        <form id="registerForm" class="auth-form">
          <h2>Créer votre compte</h2>

          <div class="row">
            <div class="field">
              <label for="firstName">Prénom *</label>
              <input id="firstName" type="text" placeholder="Ex: Ahmed" required />
            </div>
            <div class="field">
              <label for="lastName">Nom *</label>
              <input id="lastName" type="text" placeholder="Ex: Diarra" required />
            </div>
          </div>

          <div class="field">
            <label for="nationality">Nationalité *</label>
            <select id="nationality" required>
              <option value="">-- Sélectionnez --</option>
              <option>Mali</option>
              <option>Sénégal</option>
              <option>Burkina Faso</option>
              <option>Côte d'Ivoire</option>
              <option>Niger</option>
              <option>Mauritanie</option>
              <option>Guinée</option>
              <option>Bénin</option>
              <option>Togo</option>
              <option>Cameroun</option>
              <option>Autre</option>
            </select>
          </div>

          <div class="field">
            <label for="phone">Numéro de téléphone *</label>
            <input id="phone" type="tel" placeholder="+223 00 00 00 00" required />
          </div>

          <div class="field">
            <label for="email">Adresse e-mail *</label>
            <input id="email" type="email" placeholder="vous@example.com" required />
          </div>

          <div class="field">
            <label for="password">Mot de passe *</label>
            <input
              id="password"
              type="password"
              placeholder="Minimum 6 caractères"
              required
            />
          </div>

          <label class="checkbox-row">
            <input id="terms" type="checkbox" required />
            <span>J’accepte la politique de confidentialité et les conditions d’utilisation.</span>
          </label>

          <button type="submit" class="primary-btn full">Accéder au site</button>

          <p class="switch-text">
           <!-- Ligne 82: changez -->
<a href="#" class="toggle-login">Se connecter</a>

<!-- En -->
<a href="#" id="showLogin" class="toggle-login">Se connecter</a>
          </p>
        </form>

        <form id="loginForm" class="auth-form hidden">
          <h2>Connexion</h2>

          <div class="field">
            <label for="loginEmail">E-mail *</label>
            <input id="loginEmail" type="email" placeholder="votre@email.com" required />
          </div>

          <div class="field">
            <label for="loginPassword">Mot de passe *</label>
            <input
              id="loginPassword"
              type="password"
              placeholder="Votre mot de passe"
              required
            />
          </div>

          <button type="submit" class="primary-btn full">Se connecter</button>

          <p class="switch-text">
            Pas encore inscrit ?
            <a href="#" id="showRegister">Créer un compte</a>
          </p>
        </form>
      </div>

      <div class="auth-panel visual-panel">
        <div class="floating-card c1">
          <span>📚</span>
          <div>
            <strong>Apprendre</strong>
            <small>Des connaissances accessibles.</small>
          </div>
        </div>
        <div class="floating-card c2">
          <span>🧠</span>
          <div>
            <strong>Comprendre</strong>
            <small>Des contenus simples et utiles.</small>
          </div>
        </div>
        <div class="floating-card c3">
          <span>🚀</span>
          <div>
            <strong>Évoluer</strong>
            <small>Transformer les idées en actions.</small>
          </div>
        </div>
      </div>
    </div>

    <script src="script.js"></script>
  </body>
</html>